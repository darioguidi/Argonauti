{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Agent|Task",
				"hooks": {
					"type": "command",
					"command": "C:/tools/argonauti/hook.exe"
				}
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "powershell -c \"[console]::beep(800,300)\""
					}
				]
			}
		]
	}
}